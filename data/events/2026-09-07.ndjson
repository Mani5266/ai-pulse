{"article_ids": ["07e130f7120d2999"], "canonical_title": "IPGeoAI: Transformer-Based Geolocation with LLM Semantic Fusion", "category": "research", "confidence": 0.8, "description": "A new arXiv paper (IPGeoAI: Transformer‑Based Geolocation with LLM Semantic Fusion) proposes a transformer architecture that combines large‑language‑model semantic information to improve city‑level IP address location, especially for IPv6 and mobile networks, where traditional heuristics struggle.", "entities": ["term:ip"], "first_seen": "2026-09-07T04:00:00Z", "id": "evt_07e130f7120d2999", "importance_score": 5.99, "last_updated": "2026-09-07T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["881b24d9bfd5bff7"], "canonical_title": "Harbor Adapters and Harbor-Index: Infrastructure and a Curated Meta-Dataset for Large-Scale Agentic Evaluation", "category": "research", "confidence": 0.93, "description": "The authors released Harbor Adapters, a unified evaluation infrastructure that includes benchmark adapters porting more than 80 agentic benchmarks, along with a curated meta-dataset called Harbor-Index. The adapters were validated through code review and parity experiments to ensure they can evaluate arbitrary agents.", "entities": ["org:meta"], "first_seen": "2026-09-07T04:00:00Z", "id": "evt_881b24d9bfd5bff7", "importance_score": 5.89, "last_updated": "2026-09-07T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["d6ea52306dc55c89"], "canonical_title": "When Quantization Breaks Memory: Recurrent-State Write-Back in Low-Precision Temporal Inference", "category": "research", "confidence": 0.73, "description": "Researchers identified that the rule used to store quantized recurrent states—called recurrent-state write-back—affects subsequent computations. They introduced this concept and isolated its impact using a compact GRU encoder‑decoder applied to fluorescence lifetime imaging.", "entities": [], "first_seen": "2026-09-07T04:00:00Z", "id": "evt_d6ea52306dc55c89", "importance_score": 5.89, "last_updated": "2026-09-07T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["e189623dcf92020a", "fb5c0a437e159768"], "canonical_title": "UI-Venus-2 Technical Report", "category": "research", "confidence": 0.9, "description": "The authors released Mitra-v2, a tabular foundation model built on a small 2D Transformer backbone. It is trained exclusively on a large, diverse synthetic dataset, larger than that used for Mitra-v1, and achieves state-of-the-art performance on real-world classification and regression tasks such as credit-risk scoring, clinical prediction, equipment-failure detection, and house-price estimation.", "entities": ["term:gui", "term:ui"], "first_seen": "2026-09-02T04:00:00Z", "id": "evt_e189623dcf92020a", "importance_score": 5.84, "last_updated": "2026-09-07T04:00:00Z", "source_ids": ["arxiv-cs-ai", "arxiv-cs-lg"]}
{"article_ids": ["19b344bb70a61825"], "canonical_title": "Why Better Models Can Create Riskier Systems: Evidence from LLM Agents in Financial Markets", "category": "research", "confidence": 0.72, "description": "Researchers analyzed large language model (LLM) agents used in financial trading and found that increasing the individual capability of these models can actually worsen overall system outcomes. They propose that shared training data and architectures cause higher‑performing LLMs to act more similarly, leading to correlated actions that fail to diversify risk. The team introduced a general analytical framework to quantify this effect.", "entities": [], "first_seen": "2026-09-07T04:00:00Z", "id": "evt_19b344bb70a61825", "importance_score": 5.84, "last_updated": "2026-09-07T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
