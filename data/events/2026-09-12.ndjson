{"article_ids": ["a2f7f3502b2e73ce"], "canonical_title": "Autonomous Chemical Mechanistic Discovery through Agentic Reasoning and Validation", "category": "research", "confidence": 0.85, "description": "Researchers released ARCHE, an autonomous agentic platform that combines a general‑purpose reasoning model, a specialized computational chemistry model, and a structured tool registry to conduct reaction‑mechanism investigations without extensive expert input.", "entities": ["term:arche"], "first_seen": "2026-09-12T04:00:00Z", "id": "evt_a2f7f3502b2e73ce", "importance_score": 6.69, "last_updated": "2026-09-12T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["493653d4e08997a9"], "canonical_title": "DRG-MAPPO: Hierarchical Dynamic Role-Graph Multi-Agent Reinforcement Learning for Cooperative Air Combat", "category": "research", "confidence": 0.68, "description": "The arXiv paper DRG-MAPPO (2609.11155v1) presents a new multi-agent reinforcement learning method that combines a hierarchical dynamic role-graph with the MAPPO algorithm to improve tactical coordination among autonomous agents in air combat scenarios. The authors identify the lack of structured relational modeling as a key limitation of existing MARL approaches and propose their role-graph structure to capture complex, time‑varying interactions.", "entities": ["term:drg", "term:mappo", "term:marl"], "first_seen": "2026-09-12T04:00:00Z", "id": "evt_493653d4e08997a9", "importance_score": 6.04, "last_updated": "2026-09-12T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["3801eb17143c9030"], "canonical_title": "Benchmark Radar: A Living Database and Search Engine for AI Benchmarks and Evaluation", "category": "research", "confidence": 0.9, "description": "The paper introduces Benchmark Radar, a continuously updated database and search engine designed to help researchers and developers locate AI benchmark datasets, code, and evaluation settings. It indexes a wide range of benchmarks, including large language model (LLM) evaluations, agentic and tool‑use tests, coding, reasoning, safety, and domain‑specific assessments.", "entities": [], "first_seen": "2026-09-12T04:00:00Z", "id": "evt_3801eb17143c9030", "importance_score": 5.84, "last_updated": "2026-09-12T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
