{"article_ids": ["2ff506485070f8ac"], "canonical_title": "RAG-NAROK: Retrieval-Aware Knowledge Corpus Poisoning in RAG with Source-specific Refutation", "category": "research", "confidence": 0.9, "description": "The paper introduces RAG-NAROK, a retrieval‑aware knowledge‑corpus poisoning attack designed for Retrieval‑Augmented Generation (RAG) architectures. Unlike prior static attacks that inject pre‑computed adversarial documents, RAG‑NAROK generates malicious content dynamically with awareness of the retrieval process and can produce source‑specific refutations to manipulate LLM outputs.", "entities": ["term:narok"], "first_seen": "2026-09-23T04:00:00Z", "id": "evt_2ff506485070f8ac", "importance_score": 6.19, "last_updated": "2026-09-23T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["704c705f381cc859"], "canonical_title": "ChainDoRA: Tensor-Train Factorized Weight-Decomposed Low-Rank Adaptation for Parameter-Efficient LLM Fine-Tuning", "category": "research", "confidence": 0.6, "description": "The paper proposes ChainDoRA, a new parameter‑efficient fine‑tuning (PEFT) method for large language models. It builds on LoRA’s low‑rank matrices and DoRA’s separation of weight magnitude and direction, adding a tensor‑train factorization to the weight‑decomposed representation to further reduce the number of trainable parameters required for downstream adaptation.", "entities": ["term:peft"], "first_seen": "2026-09-23T04:00:00Z", "id": "evt_704c705f381cc859", "importance_score": 6.14, "last_updated": "2026-09-23T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
