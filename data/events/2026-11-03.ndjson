{"article_ids": ["f7c83376959c8478"], "canonical_title": "MXCode: Vector Quantization for MX-Native Inference at Scale", "category": "research", "confidence": 0.73, "description": "The paper introduces MXCode, a framework that combines ultra‑low‑bit vector quantization (approximately 2‑bit weight storage) with MicroXcaling (MX)‑native FP4 computation, addressing incompatibilities between traditional VQ codebooks and native FP4 hardware.", "entities": ["term:mx", "term:vq"], "first_seen": "2026-11-03T05:00:00Z", "id": "evt_f7c83376959c8478", "importance_score": 6.84, "last_updated": "2026-11-03T05:00:00Z", "source_ids": ["arxiv-cs-lg"]}
{"article_ids": ["a23ed6a46036f3e0"], "canonical_title": "Quantization of Large Models with Weight Outliers and Sparsity", "category": "research", "confidence": 0.9, "description": "The paper proposes a post‑training quantization technique that splits a model's trained weight matrix into three components—a quantized matrix, a low‑rank matrix, and a sparse matrix that captures outlier weights—aiming to lower the quantization error that typically degrades performance when reducing weight precision.", "entities": ["term:ptq"], "first_seen": "2026-11-03T05:00:00Z", "id": "evt_a23ed6a46036f3e0", "importance_score": 6.19, "last_updated": "2026-11-03T05:00:00Z", "source_ids": ["arxiv-cs-lg"]}
{"article_ids": ["6ca44218a2f8cf09"], "canonical_title": "OCELOT: Planetary-Scale Species Distribution Modeling with Satellite Foundation Embeddings", "category": "research", "confidence": 0.78, "description": "The paper announces OCELOT, a new framework that leverages billions of global species occurrence records and satellite foundation embeddings to build species distribution models at planetary scale. It addresses the bias of existing models, which use only a small subset of records and are not evaluated on extrapolating to remote, unvisited regions. OCELOT scales relational modeling to cover these under‑sampled areas.", "entities": ["term:ocelot"], "first_seen": "2026-11-03T05:00:00Z", "id": "evt_6ca44218a2f8cf09", "importance_score": 5.99, "last_updated": "2026-11-03T05:00:00Z", "source_ids": ["arxiv-cs-lg"]}
{"article_ids": ["046f31786bb677e6"], "canonical_title": "Agentic engineering intelligence with Amazon Nova Multimodal Embeddings and Amazon Bedrock AgentCore", "category": "ai_agents", "confidence": 0.95, "description": "Amazon demonstrated a multi‑agent engineering assistant that leverages Amazon Nova Multimodal Embeddings, Amazon Bedrock AgentCore, and the Strands Agents SDK to assemble substitution evidence for aerospace components, reducing evaluation time from days to minutes while keeping the engineer as the final decision‑maker.", "entities": ["model:nova", "org:amazon"], "first_seen": "2026-11-02T17:01:16Z", "id": "evt_046f31786bb677e6", "importance_score": 5.94, "last_updated": "2026-11-02T17:01:16Z", "source_ids": ["aws-machine-learning"]}
{"article_ids": ["46933a36d2603a0b"], "canonical_title": "I discovered a sound that leaks your exact location (and it's everywhere) - YouTube", "category": "other", "confidence": 0.9, "description": "Colsto demonstrated that imperceptible background noise of aircraft captured in video soundtracks can be analyzed for Doppler frequency shifts. By matching these shifts to publicly available ADS‑B flight data, the exact geographic location of the video source can be inferred.", "entities": ["org:figure", "term:ads", "term:osint"], "first_seen": "2026-11-03T05:32:25Z", "id": "evt_46933a36d2603a0b", "importance_score": 5.308, "last_updated": "2026-11-03T05:32:25Z", "source_ids": ["simon-willison"]}
