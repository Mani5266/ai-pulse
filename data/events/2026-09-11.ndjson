{"article_ids": ["ade714c19dafce35", "e3b1297ee5c185a1", "091e90be225d5a09", "4f4661ca3038bcff"], "canonical_title": "SemKV: Semantic Mixed-Precision KV Cache Quantization Guided by the Quality Cliff for Long-Context LLM Inference", "category": "research", "confidence": 0.95, "description": "SageMaker Inference now supports a prefix-aware routing strategy that directs requests sharing the same prompt prefix to the same instance, keeping the KV cache warm. Benchmarks with Llama 3.1 70B showed up to a 77% reduction in P50 time-to-first-token and KV cache hit rates rising from ~25% to over 80%.", "entities": ["model:llama", "model:llama-3.1", "org:amazon", "term:kv", "term:ood"], "first_seen": "2026-09-01T04:00:00Z", "id": "evt_ade714c19dafce35", "importance_score": 5.84, "last_updated": "2026-09-10T21:58:09Z", "source_ids": ["arxiv-cs-lg", "arxiv-cs-ai", "arxiv-cs-cl", "aws-machine-learning"]}
{"article_ids": ["91b5c6ab21e16bac"], "canonical_title": "Agent Evaluation Metric for multi-turn conversations", "category": "ai_agents", "confidence": 0.95, "description": "AWS announced the Agent Evaluation Metric (AEM), a decomposable, turn‑level metric for evaluating multi‑turn conversational agents. The metric focuses on correctness, allowing identification of the specific turn that caused a failure and separating it from later turns that inherit the error.", "entities": ["term:aem"], "first_seen": "2026-09-10T15:55:41Z", "id": "evt_91b5c6ab21e16bac", "importance_score": 5.84, "last_updated": "2026-09-10T15:55:41Z", "source_ids": ["aws-machine-learning"]}
{"article_ids": ["914dba05ced926e8"], "canonical_title": "Reduce inference cold starts on Amazon SageMaker HyperPod with model caching", "category": "open_source", "confidence": 0.95, "description": "SageMaker HyperPod now supports model caching for inference. The feature pre‑loads model weights and container images onto each cluster node and stores them on local NVMe storage, allowing pods to read models locally instead of downloading over the network. This reduces cold‑start latency from tens of minutes to seconds.", "entities": ["org:amazon"], "first_seen": "2026-09-10T21:37:49Z", "id": "evt_914dba05ced926e8", "importance_score": 5.745, "last_updated": "2026-09-10T21:37:49Z", "source_ids": ["aws-machine-learning"]}
{"article_ids": ["e848784e7448b9b9"], "canonical_title": "Rubric-Aligned Disentangled Evaluation of Human Simultaneous Interpreting", "category": "research", "confidence": 0.8, "description": "The authors created a professionally annotated corpus of 1,101 human simultaneous interpreting (SI) segments, each scored for meaning transfer (LQ), delivery quality (EXP), and perceived latency (LAT). They then demonstrated that structured prompting of large language models (LLMs) combined with scalar supervision can produce automatic metrics that align with these rubric dimensions at the segment level.", "entities": ["term:lq", "term:si"], "first_seen": "2026-09-11T04:00:00Z", "id": "evt_e848784e7448b9b9", "importance_score": 5.29, "last_updated": "2026-09-11T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["2bb26ca5b829bac9"], "canonical_title": "Overview of the NLPCC 2026 Shared Task 11: Agent-Based Experiment Reproduction from Scientific Papers", "category": "research", "confidence": 0.8, "description": "The NLPCC 2026 Shared Task 11 announced a new benchmark called AgentActionBench, designed to evaluate large‑language‑model agents on reproducing scientific experiments from papers. Unlike prior evaluations that focus on final code repositories and mainly machine‑learning tasks, this benchmark emphasizes the full experimental workflow.", "entities": ["term:nlpcc"], "first_seen": "2026-09-11T04:00:00Z", "id": "evt_2bb26ca5b829bac9", "importance_score": 5.09, "last_updated": "2026-09-11T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
