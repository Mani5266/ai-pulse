{"article_ids": ["d1c93a9a4173c0b2"], "canonical_title": "Abnormal AI: Amazon Bedrock AgentCore for agentic email security at scale", "category": "ai_agents", "confidence": 0.8, "description": "Abnormal AI deployed Amazon Bedrock AgentCore Code Interpreter as an ephemeral compute scratch pad for the agents that power its real‑time email threat detection system, handling detection at a scale of billions of messages. The article also describes the sandbox design choices and practical lessons learned when running Code Interpreter in production.", "entities": ["org:amazon"], "first_seen": "2026-09-14T21:22:45Z", "id": "evt_d1c93a9a4173c0b2", "importance_score": 5.89, "last_updated": "2026-09-14T21:22:45Z", "source_ids": ["aws-machine-learning"]}
{"article_ids": ["8dff944158cfc526"], "canonical_title": "Identity Is More Than Recall: A Benchmark for Persistent Identity in Deployed AI Agents", "category": "research", "confidence": 0.9, "description": "Researchers introduced PAI-Bench, a provider‑neutral benchmark that tests AI agents on maintaining a versioned, update‑governed identity contract. The benchmark separates recall, composition, behavioral enactment, resistance, persistence, lineage, and role‑conditioned updates, and uses scoring oracles external to the target process. Two frozen campaigns covering sixteen synthetic tasks are provided.", "entities": ["term:pai"], "first_seen": "2026-09-15T04:00:00Z", "id": "evt_8dff944158cfc526", "importance_score": 5.59, "last_updated": "2026-09-15T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["fce2716ef9e8c465"], "canonical_title": "How Ninth Wave built AI-powered open finance onboarding on Amazon Bedrock", "category": "policy", "confidence": 0.95, "description": "Ninth Wave created Compass, a multi‑agent AI onboarding assistant built on Amazon Bedrock AgentCore. Compass validates bank APIs against the Financial Data Exchange (FDX) standards, scores their compliance, and automates open‑finance onboarding, reducing the process from weeks to minutes while meeting SOC 2 and PCI DSS requirements.", "entities": ["org:amazon", "term:dss", "term:fdx", "term:pci", "term:soc"], "first_seen": "2026-09-14T15:58:57Z", "id": "evt_fce2716ef9e8c465", "importance_score": 5.15, "last_updated": "2026-09-14T15:58:57Z", "source_ids": ["aws-machine-learning"]}
{"article_ids": ["e52b0024cc5c06e8"], "canonical_title": "Perplexity Portable Computer Is Now Available on Windows, Powered by NVIDIA RTX", "category": "model_release", "confidence": 0.85, "description": "Perplexity released the Portable Computer, a local version of its AI agent, for Windows. It runs on the device using NVIDIA RTX GPUs and local language models to plan and execute multistep tasks while keeping data on‑device.", "entities": ["org:nvidia", "org:perplexity", "term:nvidia", "term:pc", "term:rtx"], "first_seen": "2026-09-14T15:00:52Z", "id": "evt_e52b0024cc5c06e8", "importance_score": 5.147, "last_updated": "2026-09-14T15:00:52Z", "source_ids": ["nvidia"]}
{"article_ids": ["1cb051040f96fc49"], "canonical_title": "Evaluating LLM-Generated Rules for Heart Disease Prediction", "category": "research", "confidence": 0.6, "description": "The paper evaluates traditional classifiers (Logistic Regression, K‑Nearest Neighbors, SVM, Naive Bayes, Decision Tree, Random Forest) and rule‑based systems automatically generated by GPT‑4o and Claude Sonnet 4.6 on the UCI Heart Disease dataset, reporting their predictive performance.", "entities": ["term:knn", "term:svm", "term:uci"], "first_seen": "2026-09-15T04:00:00Z", "id": "evt_1cb051040f96fc49", "importance_score": 5.09, "last_updated": "2026-09-15T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
