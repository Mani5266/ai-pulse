{"article_ids": ["4d611d68a5a28f31"], "canonical_title": "Fast Models, Slow Evidence: A Paired and Self-Audited Evaluation of System-1 Decision Models for LLM Agent Harnesses", "category": "research", "confidence": 0.78, "description": "Researchers evaluated two System-1 decision models—an open‑weight model named Laya and a hosted model named Jev—across 11 decision points used by LLM agents, such as model selection, tool choice, relevance filtering, and injection detection. The models produce class probabilities in a single forward pass, aiming to replace multiple LLM calls.", "entities": [], "first_seen": "2026-10-05T04:00:00Z", "id": "evt_4d611d68a5a28f31", "importance_score": 6.24, "last_updated": "2026-10-05T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["25f0cb851e6be810"], "canonical_title": "DeReAct: Decomposed Reasoning and Acting for Reliable AI Agents", "category": "research", "confidence": 0.73, "description": "The paper presents DeReAct, a new agent architecture that separates reasoning, action proposal, and task‑completion control by adding two external gating policies, including a Critic that validates proposed actions, addressing error propagation in single‑policy ReAct agents.", "entities": [], "first_seen": "2026-10-05T04:00:00Z", "id": "evt_25f0cb851e6be810", "importance_score": 5.89, "last_updated": "2026-10-05T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["0cf18f180d63c3e4"], "canonical_title": "Learning What to Investigate Next: Meta-Reasoning for Long-Horizon Research Agents", "category": "research", "confidence": 0.95, "description": "The paper introduces Meta-reasoning for Iterative Research Agents (MIRA), a hierarchical system that separates research allocation from execution. An outer-loop meta-reasoner curates context and decides both how to investigate and what to investigate next as evidence accumulates, addressing the sparsity of decision signals and delayed consequences in long execution traces.", "entities": ["org:meta", "term:mira"], "first_seen": "2026-10-05T04:00:00Z", "id": "evt_0cf18f180d63c3e4", "importance_score": 5.59, "last_updated": "2026-10-05T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["25179040a1b70341"], "canonical_title": "MEA: A Reward-Driven Multi-Agent System for Faithful Model Explanations", "category": "research", "confidence": 0.6, "description": "The paper titled “MEA: A Reward‑Driven Multi‑Agent System for Faithful Model Explanations” proposes a new system (MEA) that uses a reward‑driven multi‑agent architecture to generate post‑hoc explanations of machine‑learning models, aiming to reduce the expertise required to interpret high‑dimensional outputs and to synthesize evidence across tools.", "entities": ["term:mea"], "first_seen": "2026-10-05T04:00:00Z", "id": "evt_25179040a1b70341", "importance_score": 5.29, "last_updated": "2026-10-05T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["e0db1ebe22ac4731"], "canonical_title": "MACTS-EM: Multi-Agent Collaborative Time Series Forecasting with Emergent Memory", "category": "research", "confidence": 0.9, "description": "The arXiv paper MACTS-EM presents a new framework called Multi-Agent Collaborative Time Series Forecasting with Emergent Memory. It uses specialised agents that cooperate and share an emergent memory component to address challenges such as regime shifts, cross‑domain knowledge transfer, and multimodal data integration, aiming for superior forecasting performance.", "entities": ["term:em", "term:macts"], "first_seen": "2026-10-05T04:00:00Z", "id": "evt_e0db1ebe22ac4731", "importance_score": 5.24, "last_updated": "2026-10-05T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
