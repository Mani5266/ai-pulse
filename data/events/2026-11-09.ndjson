{"article_ids": ["2002ac7723e953db"], "canonical_title": "DUET: Dual-Sparse Inference for Block Diffusion Language Models", "category": "research", "confidence": 0.7, "description": "The paper presents DUET, a dual-sparse inference technique for block diffusion language models that reduces the repeated attention over the growing historical prefix and avoids processing the entire current generation block at every denoising step.", "entities": ["term:duet"], "first_seen": "2026-11-09T05:00:00Z", "id": "evt_2002ac7723e953db", "importance_score": 6.04, "last_updated": "2026-11-09T05:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["8ed01078601b2847"], "canonical_title": "MARS: Training Multilingual Search Agents for Retriever-Free Evidence Acquisition", "category": "research", "confidence": 0.85, "description": "The paper \"MARS: Training Multilingual Search Agents for Retriever-Free Evidence Acquisition\" proposes a new paradigm for multilingual retrieval-augmented generation. Instead of using learned retrievers and similarity ranking, the model directly interacts with raw multilingual corpora by generating executable shell commands, shifting the bottleneck to multilingual search action generation.", "entities": ["term:mars"], "first_seen": "2026-11-09T05:00:00Z", "id": "evt_8ed01078601b2847", "importance_score": 5.84, "last_updated": "2026-11-09T05:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["eb25380cc5e40adb"], "canonical_title": "NVIDIA Dynamo Recipes Bring Korea’s Leading Open Models to Production", "category": "infrastructure", "confidence": 0.9, "description": "NVIDIA announced Dynamo-optimized deployment recipes for four Korean open models—A.X K2 (SK Telecom), K-EXAONE 2.0 (LG AI Research), Solar Open 2 (Upstage) and Motif-3 (Motif Technologies). The recipes target models that exceed a single GPU's memory, providing guidance for splitting models across multiple GPUs and coordinating request routing.", "entities": ["org:nvidia", "term:exaone", "term:lg", "term:nvidia", "term:sk"], "first_seen": "2026-11-09T05:00:00Z", "id": "evt_eb25380cc5e40adb", "importance_score": 5.672, "last_updated": "2026-11-09T05:00:00Z", "source_ids": ["nvidia"]}
{"article_ids": ["a57aacc0bac858e6"], "canonical_title": "Mind the Divergence: Divergence-Guided Reliability-Aware Fusion and Adaptive LLM Prompting for Conversational Emotion Recognition", "category": "research", "confidence": 0.73, "description": "Researchers introduced a reliability‑aware fusion technique that uses inter‑modal predictive divergence to weight textual, acoustic, and visual cues, and an adaptive large‑language‑model prompting strategy for conversational emotion recognition (MERC). The approach explicitly adapts processing based on the degree of disagreement among modalities, aiming to handle semantic incongruity, concealed emotions, noise, and ambiguity.", "entities": ["term:merc"], "first_seen": "2026-11-09T05:00:00Z", "id": "evt_a57aacc0bac858e6", "importance_score": 5.64, "last_updated": "2026-11-09T05:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["77625322d4684167", "698f0868e7dfb446"], "canonical_title": "Korea’s AI Ecosystem Advances and Secures Agentic AI With NVIDIA", "category": "ai_agents", "confidence": 0.78, "description": "NVIDIA announced an expanded collaboration with South Korea's Ministry of Science and ICT and Korean industry players. Hyundai Motor Group is evaluating NVIDIA's NemoClaw blueprints and OpenShell runtime, while AIM Intelligence is integrating its Starfort platform with OpenShell to enable secure AI agents for enterprise workflows. The partnership now covers AI semiconductors, data‑center infrastructure, talent development, startups, models, agents and security, and opens the path for Korean NPU/XPU firms to join NVIDIA's NVLink Fusion ecosystem.", "entities": ["org:nvidia", "term:aim", "term:nvidia", "term:ict", "term:msit", "term:npu", "term:xpu"], "first_seen": "2026-11-09T05:00:04Z", "id": "evt_77625322d4684167", "importance_score": 5.547, "last_updated": "2026-11-09T05:00:39Z", "source_ids": ["nvidia"]}
