{"article_ids": ["fa47e7a40218fa2d"], "canonical_title": "REAL-Q: E2E LLM Quantization via Dynamic Gradient Descent", "category": "research", "confidence": 0.6, "description": "The paper presents REAL-Q, a new post‑training quantization (PTQ) method for large language models that replaces the traditional single closed‑form second‑order solver with a dynamic gradient descent approach. This technique avoids the heavy approximations of global loss and the static Hessian freezing used in prior PTQ methods, enabling more accurate layer‑wise quantization.", "entities": ["term:ptq", "term:real"], "first_seen": "2026-09-02T04:00:00Z", "id": "evt_fa47e7a40218fa2d", "importance_score": 6.49, "last_updated": "2026-09-02T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
{"article_ids": ["199ba73ff1111eb3"], "canonical_title": "Generative artificial intelligence for reliable mechanistic reasoning for corrosion", "category": "research", "confidence": 0.7, "description": "A new arXiv pre‑print (arXiv:2609.00099v1) introduces a generative artificial‑intelligence approach aimed at providing mechanistically defensible reasoning for corrosion. Existing machine‑learning models can predict corrosion rates from composition, microstructure, and environment but lack explanatory power. The proposed method seeks to combine accurate retrieval with explanations of the underlying mechanisms, addressing a gap in safety‑critical materials engineering.", "entities": ["term:gdp"], "first_seen": "2026-09-02T04:00:00Z", "id": "evt_199ba73ff1111eb3", "importance_score": 6.04, "last_updated": "2026-09-02T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
{"article_ids": ["f2694bfa96c49e91"], "canonical_title": "Path to Astra: critical capabilities and frontier safeguards", "category": "model_release", "confidence": 0.95, "description": "OpenAI announced that its Astra model is the first model to satisfy the Critical cybersecurity capability threshold defined in the company's Preparedness Framework, and it includes stronger safeguards for release.", "entities": ["org:openai"], "first_seen": "2026-09-01T13:00:00Z", "id": "evt_f2694bfa96c49e91", "importance_score": 5.85, "last_updated": "2026-09-01T13:00:00Z", "source_ids": ["openai"]}
{"article_ids": ["e698148a3f7fc433"], "canonical_title": "NVIDIA and CrowdStrike Strengthen Agentic Cybersecurity Frontier", "category": "ai_agents", "confidence": 0.78, "description": "At CrowdStrike's Fal.Con 2026, NVIDIA CEO Jensen Huang and CrowdStrike CEO George Kurtz announced a partnership to launch CrowdStrike SafeMind, an agentic cybersecurity system designed to automate defense against automated attacks.", "entities": ["org:nvidia", "term:nvidia"], "first_seen": "2026-09-01T21:19:20Z", "id": "evt_e698148a3f7fc433", "importance_score": 5.748, "last_updated": "2026-09-01T21:19:20Z", "source_ids": ["nvidia"]}
{"article_ids": ["a6075ac6792b7e89"], "canonical_title": "Deterministic LLM Inference Across GPU Kernels: Power-of-Two INT8 Quantization Scales and the Limits of Tolerance-Based Conformance", "category": "research", "confidence": 0.8, "description": "Researchers evaluated tolerance‑based conformance suites for quantized GEMM kernels used in LLM inference. By injecting nine faults into an INT8 pipeline running the Qwen3‑1.7B model across 8,232 layer‑fault cells, they observed that each of five epilogue faults (scale precision, double rounding, multiplication order, output truncation, fused ordering) altered the output by at most one bfloat16 spacing.", "entities": ["model:qwen", "model:qwen-3", "term:gemm"], "first_seen": "2026-09-02T04:00:00Z", "id": "evt_a6075ac6792b7e89", "importance_score": 5.74, "last_updated": "2026-09-02T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
