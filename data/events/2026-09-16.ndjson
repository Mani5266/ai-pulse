{"article_ids": ["a0a76519ad261018"], "canonical_title": "Optimizing cost and latency with Amazon Bedrock prompt caching", "category": "developer_tools", "confidence": 0.97, "description": "Amazon Bedrock introduced a prompt caching feature that stores repeated prompt context for reuse across calls to foundation models via the Converse API. The feature can reduce input token usage by up to 90% and is illustrated in six scenarios: caching message content, system prompts, tool definitions, mixed TTL, tenant isolation, and LangChain integration.", "entities": ["org:amazon", "product:langchain", "term:ttl"], "first_seen": "2026-09-15T16:18:19Z", "id": "evt_a0a76519ad261018", "importance_score": 6.15, "last_updated": "2026-09-15T16:18:19Z", "source_ids": ["aws-machine-learning"]}
{"article_ids": ["6aae488b1bb65e59", "25823e681aab7b46", "9da1736b8159c9ab"], "canonical_title": "Introducing Gemini 3.8 Live and 3.8 Live Extended Thinking", "category": "model_release", "confidence": 0.88, "description": "Google announced Gemini 3.8 Live and Gemini 3.8 Live Extended Thinking, two new speech-to-speech models. They support real-time voice interaction, allow users to interrupt the model while it is speaking, and can be accessed via a web UI that lets you pick model and voice preset and add an optional system prompt.", "entities": ["model:gemini", "model:gemini-3", "model:gemini-3.8", "model:gpt", "model:gpt-6", "org:google", "org:openai", "term:gpt", "term:ui", "term:url"], "first_seen": "2026-09-15T17:05:57Z", "id": "evt_6aae488b1bb65e59", "importance_score": 5.85, "last_updated": "2026-09-15T22:47:07Z", "source_ids": ["google-deepmind", "hacker-news", "simon-willison"]}
{"article_ids": ["25cb6d47a727e9df"], "canonical_title": "The Imitation Game: When LLMs Learn to Reason Like Programs via Code-Centric Reasoning Data Synthesis", "category": "research", "confidence": 0.85, "description": "The paper introduces MIMIC, a framework that generates reasoning data by converting algorithms into executable code trajectories. By treating code as a rigorous medium, MIMIC creates verifiable, step‑by‑step reasoning paths that LLMs can learn from, aiming to improve deterministic, fine‑grained reasoning that LLMs typically handle only via semantic approximation.", "entities": ["term:mimic"], "first_seen": "2026-09-16T04:00:00Z", "id": "evt_25cb6d47a727e9df", "importance_score": 5.84, "last_updated": "2026-09-16T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["f96756bd82d7a91e"], "canonical_title": "Retrieval-Driven Memory Reconsolidation for Long-Term LLM Agents", "category": "research", "confidence": 0.85, "description": "A new approach called Retrieval-Driven Memory Reconsolidation is introduced for large language model (LLM) agents. Unlike prior systems that only update memory when new information arrives and treat retrieval as a final step, this method continuously reorganizes stored memory using feedback from retrieval operations, enabling ongoing refinement of memory structures.", "entities": [], "first_seen": "2026-09-16T04:00:00Z", "id": "evt_f96756bd82d7a91e", "importance_score": 5.69, "last_updated": "2026-09-16T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["acfc7f548a899d3e"], "canonical_title": "Bypassing inference bottlenecks: Accelerating complex AI search with Retrieve-for-Train", "category": "infrastructure", "confidence": 0.4, "description": "Google Research introduced a set of algorithms and theoretical analysis called Retrieve-for-Train, intended to accelerate complex AI search by reducing inference bottlenecks.", "entities": [], "first_seen": "2026-09-15T20:00:35Z", "id": "evt_acfc7f548a899d3e", "importance_score": 5.425, "last_updated": "2026-09-15T20:00:35Z", "source_ids": ["google-research"]}
