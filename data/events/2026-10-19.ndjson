{"article_ids": ["5d023c2a1961329c"], "canonical_title": "TRACE: Transformer Residual Activation Codebook Encoding for Communication-efficient Distributed Edge Inference", "category": "research", "confidence": 0.73, "description": "The paper presents TRACE, a method that encodes residual activations of Transformers using a codebook to reduce the amount of data exchanged between sequence‑parallel partitions on co‑located edge devices. It targets the communication bottleneck where activation exchange dominates latency and where existing compression still requires costly key/value projection before attention can continue.", "entities": ["term:trace"], "first_seen": "2026-10-19T04:00:00Z", "id": "evt_5d023c2a1961329c", "importance_score": 6.19, "last_updated": "2026-10-19T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
{"article_ids": ["051009ada2a4f647"], "canonical_title": "On the SPOT: Enhancing Speculative Decoding for Diffusion Language Models via Commit-Order Prediction", "category": "research", "confidence": 0.7, "description": "The paper introduces SPOT, a technique that enhances speculative decoding for diffusion language models (DLMs) by predicting the commit order of generated tokens. This addresses the existing speed‑quality trade‑off where exact decoding is slow (one masked position per pass) and existing multi‑token schemes are lossy, and adapts speculative decoding—previously used for autoregressive models—to DLMs, which must decide both what to generate and where.", "entities": ["term:spot"], "first_seen": "2026-10-19T04:00:00Z", "id": "evt_051009ada2a4f647", "importance_score": 5.89, "last_updated": "2026-10-19T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
{"article_ids": ["68a22c93d260e4f1"], "canonical_title": "The Model Knows Better: Defending Medical Multi-Agent Systems Against Prompt Injection", "category": "research", "confidence": 0.78, "description": "A study of two medical multi‑agent decision‑support systems, using two LLM families and three benchmarks, found that inserting a single malicious passage caused the agents to make incorrect decisions in as many as 61% of test cases. The presence of multiple collaborating agents did not consistently reduce the attack success rate.", "entities": [], "first_seen": "2026-10-19T04:00:00Z", "id": "evt_68a22c93d260e4f1", "importance_score": 5.49, "last_updated": "2026-10-19T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["ae6e49210029e41a"], "canonical_title": "Hybrid Reasoning Agents: LLM agents that think in latent space, act through text", "category": "policy", "confidence": 0.65, "description": "A new open‑source project called HybridAgent (by Together Computer) introduces \"Hybrid Reasoning Agents\" that perform internal reasoning in the model's latent space and produce actions as plain text. The announcement includes a GitHub repository, a HuggingFace collection, and an arXiv pre‑print describing evaluations of the approach.", "entities": ["org:huggingface", "term:url"], "first_seen": "2026-10-18T20:48:14Z", "id": "evt_ae6e49210029e41a", "importance_score": 5.393, "last_updated": "2026-10-18T20:48:14Z", "source_ids": ["hacker-news"]}
{"article_ids": ["a6f4da06fdba1089"], "canonical_title": "Sparse Autoencoders Can Induce Local Geometry for Mitigating Catastrophic Forgetting", "category": "research", "confidence": 0.9, "description": "The paper presents Sparse Autoencoder Geometric Anchoring (SAGA), a method that trains a Sparse Autoencoder at each task boundary and converts it into local, low‑rank geometric constraints. These constraints are intended to limit representation drift when learning new tasks, thereby mitigating catastrophic forgetting in supervised continual learning settings.", "entities": ["term:saga"], "first_seen": "2026-10-19T04:00:00Z", "id": "evt_a6f4da06fdba1089", "importance_score": 5.39, "last_updated": "2026-10-19T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
