{"article_ids": ["4d9ba65d928070f9"], "canonical_title": "FedEHR-Agents: Federated Agentic Optimization for Automated EHR Modeling", "category": "research", "confidence": 0.7, "description": "The paper introduces FedEHR-Agents, a framework that combines federated learning with autonomous large‑language‑model agents to automate electronic health record (EHR) modeling workflows across multiple hospitals while keeping patient‑level data on‑site.", "entities": ["term:ehr"], "first_seen": "2026-08-31T04:00:00Z", "id": "evt_4d9ba65d928070f9", "importance_score": 6.29, "last_updated": "2026-08-31T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
{"article_ids": ["148c6c4e315ab497"], "canonical_title": "DAMP: Decay-Aware Mixed-Precision Recurrent-State Quantization", "category": "research", "confidence": 0.9, "description": "The paper DAMP: Decay-Aware Mixed-Precision Recurrent-State Quantization proposes a quantization scheme that stores the fixed-size recurrent states used by Gated DeltaNet and Kimi Delta Attention in lower precision, while accounting for decay characteristics, to reduce the FP32 memory and bandwidth demands during inference.", "entities": ["model:kimi", "term:damp", "term:gdn", "term:kda", "term:kv"], "first_seen": "2026-08-31T04:00:00Z", "id": "evt_148c6c4e315ab497", "importance_score": 6.07, "last_updated": "2026-08-31T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
{"article_ids": ["e8eb764492cfd1fa"], "canonical_title": "Accelerating LLM Inference via Vector Index Based Output Embeddings", "category": "research", "confidence": 0.8, "description": "The paper proposes reformulating the output projection and top‑k token selection in autoregressive LLM decoding as a maximum inner product search over token embeddings. Instead of a dense matrix multiply against the full vocabulary, an HNSW‑based vector index is used to retrieve a small candidate set of high‑scoring tokens, which are then scored to produce the final top‑k output.", "entities": [], "first_seen": "2026-08-31T04:00:00Z", "id": "evt_e8eb764492cfd1fa", "importance_score": 6.04, "last_updated": "2026-08-31T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["1e4ec3c41470e0ec"], "canonical_title": "Nemotron 3.5 Content Safety Moderator: A Compact Multimodal, Multilingual, and Reasoning Enabled Content Safety Moderator", "category": "research", "confidence": 0.9, "description": "The paper announces Nemotron 3.5 Content Safety Moderator, a new model that can evaluate text, images, documents, screenshots, and generated responses. It combines broad coverage, custom policy control, multilingual support, and reasoning abilities while keeping compute requirements low.", "entities": ["model:nemotron", "model:nemotron-3.5"], "first_seen": "2026-08-31T04:00:00Z", "id": "evt_1e4ec3c41470e0ec", "importance_score": 5.99, "last_updated": "2026-08-31T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["50f3e4108132ef6a"], "canonical_title": "PACE: Publisher-Adaptive Content Extraction via Agentic Automation", "category": "research", "confidence": 0.62, "description": "The paper titled \"PACE: Publisher-Adaptive Content Extraction via Agentic Automation\" (arXiv:2608.27466v1) presents a new method for extracting web content that aims to balance accuracy, scalability, and adaptability. It addresses brittleness of general-purpose extractors on publisher‑specific layouts and the high cost and latency of direct LLM‑based extraction, proposing an agentic automation approach to improve extraction of metadata, images, tables, and other rich targets.", "entities": ["term:pace"], "first_seen": "2026-08-31T04:00:00Z", "id": "evt_50f3e4108132ef6a", "importance_score": 5.99, "last_updated": "2026-08-31T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
