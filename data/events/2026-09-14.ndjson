{"article_ids": ["0288ccf77a04bc0b"], "canonical_title": "FINESSE: An Agent-Based Simulator and Benchmark Dataset for Multimodal Financial Event Sequences", "category": "research", "confidence": 0.8, "description": "The authors present FINESSE, an agent‑based simulation environment that generates synthetic financial event sequences across multiple modalities and includes a benchmark dataset, addressing the lack of open‑source, multimodal financial data.", "entities": [], "first_seen": "2026-09-14T04:00:00Z", "id": "evt_0288ccf77a04bc0b", "importance_score": 5.89, "last_updated": "2026-09-14T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
{"article_ids": ["d47ce9e1ec3463df"], "canonical_title": "AIM: A Privacy-Aware Interoperable Memory Framework for Multi-Agent Multi-User LLM Systems", "category": "research", "confidence": 0.78, "description": "Researchers released AIM (Agentic Interoperable Memory), a framework that lets large language model agents store and retrieve information across multiple users and sessions while enforcing privacy constraints, addressing limits of single-session LLMs and prior single-user memory systems.", "entities": ["term:aim"], "first_seen": "2026-09-14T04:00:00Z", "id": "evt_d47ce9e1ec3463df", "importance_score": 5.74, "last_updated": "2026-09-14T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["eca1621c86adba37"], "canonical_title": "GAUGE: When Not to Trust LLM-as-a-Judge in User-Simulated Evaluation of Task-Oriented Agents", "category": "research", "confidence": 0.78, "description": "The paper presents GAUGE, a reusable offline protocol that assesses whether rankings produced by an LLM-as-a-judge in persona‑driven user‑simulated evaluations align with a grounded, verifiable reward. GAUGE was applied to 25 task‑oriented LLM agents from six providers on the τ²‑bench and Simula benchmarks to measure this alignment.", "entities": ["term:gauge"], "first_seen": "2026-09-14T04:00:00Z", "id": "evt_eca1621c86adba37", "importance_score": 5.74, "last_updated": "2026-09-14T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["3fc04fab25cfa747"], "canonical_title": "Extracting Dataset Mentions in Forced Displacement and FCV Documents: A Weakly Supervised Framework with LLM-Based Label Refinement", "category": "research", "confidence": 0.85, "description": "Researchers introduced a weakly supervised extraction system that leverages large language models for label refinement to identify references to humanitarian datasets across research papers, project documents, and reports. The approach addresses the difficulty of locating dispersed dataset mentions in unstructured text.", "entities": ["term:fcv"], "first_seen": "2026-09-14T04:00:00Z", "id": "evt_3fc04fab25cfa747", "importance_score": 5.49, "last_updated": "2026-09-14T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["e3d31cddb6d22880"], "canonical_title": "EAR: Entity-Aware Partitioning Approach for Retrieval-Augmented Generation Development", "category": "research", "confidence": 0.7, "description": "The paper presents EAR, an Entity-Aware Partitioning method that replaces fixed-size text chunks with passages segmented around normalized surface entity anchors. This approach is designed for retrieval-augmented generation (RAG) applied to multiple‑choice question answering, aiming to return more directly relevant passages than traditional chunking.", "entities": ["term:ear"], "first_seen": "2026-09-14T04:00:00Z", "id": "evt_e3d31cddb6d22880", "importance_score": 5.49, "last_updated": "2026-09-14T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
