{"article_ids": ["3b3ce10c52b59a0a"], "canonical_title": "Reasoning with Context Management and External Memory", "category": "research", "confidence": 0.93, "description": "The paper \"Reasoning with Context Management and External Memory\" (arXiv:2610.24187v1) proposes a new approach called RCMEM. It extends existing in‑context memory mechanisms with an external memory component, allowing reasoning models to retain additional information without overloading the model's internal context window.", "entities": ["term:rcmem"], "first_seen": "2026-10-20T04:00:00Z", "id": "evt_3b3ce10c52b59a0a", "importance_score": 5.84, "last_updated": "2026-10-20T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["bfa70917f3b198d1"], "canonical_title": "Nvidia launches new open models to run agents in the enterprise and on PCs", "category": "model_release", "confidence": 0.93, "description": "Nvidia announced new open-source models designed to run AI agents in corporate data centers and on personal computers, targeting enterprises that want to host their own models and on-device private agents.", "entities": ["org:nvidia"], "first_seen": "2026-10-19T15:37:09Z", "id": "evt_bfa70917f3b198d1", "importance_score": 5.793, "last_updated": "2026-10-19T15:37:09Z", "source_ids": ["techcrunch-ai"]}
{"article_ids": ["a01a5d49df06358e"], "canonical_title": "A hacker broke into John Deere and SharkNinja with an army of AI agents", "category": "ai_agents", "confidence": 0.85, "description": "According to AI security firm Norforge, a hacker deployed an army of AI agents that largely operated on their own to infiltrate more than 100 websites. Reported victims include John Deere, SharkNinja, and Cummins, though Norforge did not name all targets.", "entities": [], "first_seen": "2026-10-19T13:58:41Z", "id": "evt_a01a5d49df06358e", "importance_score": 5.793, "last_updated": "2026-10-19T13:58:41Z", "source_ids": ["the-verge-ai"]}
{"article_ids": ["71cf1fc71504fea5"], "canonical_title": "Push-based KV transfer to improve TTFT and TPOT for disaggregated inference in vLLM", "category": "infrastructure", "confidence": 0.95, "description": "AWS introduced a push‑based NIXL connector that moves key‑value (KV) cache transfer off the critical path in vLLM's prefill‑decode disaggregation. Benchmarks on Amazon EC2 P5en instances with AWS EFA show up to 3× faster time‑to‑first‑token (TTFT) and about 30% higher tokens‑per‑output‑token (TPOT).", "entities": ["org:amazon", "product:vllm", "term:aws", "term:efa", "term:kv", "term:nixl", "term:tpot", "term:ttft"], "first_seen": "2026-10-19T16:05:17Z", "id": "evt_71cf1fc71504fea5", "importance_score": 5.758, "last_updated": "2026-10-19T16:05:17Z", "source_ids": ["aws-machine-learning"]}
{"article_ids": ["03edfbf4ceca2ade"], "canonical_title": "Joint, Decoupled, or Agent: When Each Multimodal Alignment Paradigm Wins", "category": "research", "confidence": 0.78, "description": "The paper \"Joint, Decoupled, or Agent: When Each Multimodal Alignment Paradigm Wins\" systematically evaluates three multimodal alignment approaches—jointly pretrained encoders, decoupled fusion heads, and an agent‑style method—using public checkpoints on 16 paired datasets spanning five domains and varying training‑label budgets. The authors report which paradigm performs best under different data and budget conditions.", "entities": ["term:joint"], "first_seen": "2026-10-20T04:00:00Z", "id": "evt_03edfbf4ceca2ade", "importance_score": 5.64, "last_updated": "2026-10-20T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
