{"article_ids": ["c6ae3beb79b8ee8b"], "canonical_title": "Improving HCLS AI reasoning with open-source agent skills", "category": "ai_agents", "confidence": 0.9, "description": "AWS published a blog post detailing 38 open-source agent skills spanning 11 healthcare and life sciences (HCLS) domains. The post includes installation instructions, three worked use cases, and an evaluation on 410 prompts that achieved a 70-86% win rate, aiming to correct misapplication of HCLS decision frameworks by AI agents.", "entities": ["term:hcls"], "first_seen": "2026-09-16T19:00:00Z", "id": "evt_c6ae3beb79b8ee8b", "importance_score": 5.99, "last_updated": "2026-09-16T19:00:00Z", "source_ids": ["aws-machine-learning"]}
{"article_ids": ["f0ae685a2d734338"], "canonical_title": "ERPBench: A State-Grounded Evaluation Paradigm for Computer-Use Agents in Enterprise Software", "category": "research", "confidence": 0.82, "description": "Researchers released ERPBench, a state‑grounded evaluation framework targeting computer‑use agents that interact with enterprise resource planning software. The benchmark addresses the limitations of existing evaluations that focus on general desktop and web tasks by incorporating the dense interfaces, coordinated multi‑step workflows, and error‑sensitive operations typical of ERP applications.", "entities": ["term:erp"], "first_seen": "2026-09-17T04:00:00Z", "id": "evt_f0ae685a2d734338", "importance_score": 5.94, "last_updated": "2026-09-17T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["127d99a33bbcc048"], "canonical_title": "Enhancing Extubation Failure Prediction with LLM-Derived Features from Respiratory Therapy Clinical Notes", "category": "research", "confidence": 0.8, "description": "Researchers introduced a pipeline that uses a large language model to classify and extract features from free‑text respiratory therapy clinical notes, then feeds those features into a logistic regression model to predict extubation failure. The approach was evaluated on a patient cohort from University of Washington Medicine and was reported to identify clinically relevant predictors of failure.", "entities": ["term:ef"], "first_seen": "2026-09-17T04:00:00Z", "id": "evt_127d99a33bbcc048", "importance_score": 5.84, "last_updated": "2026-09-17T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["e45a3548a7d56165", "15fe6167da12d22f"], "canonical_title": "LayerRoute: Adaptive Layer-Skipping with LoRA-Preserved Quality for Efficient LLM Inference", "category": "research", "confidence": 0.78, "description": "The authors measured 54 inference configurations of the Qwen2.5‑7B‑Instruct model using vLLM 0.12 on L4, A100, and H100 GPUs. From these measurements they built a Pareto atlas that identifies which optimizations dominate the cost‑quality‑latency frontier for different deployment constraints, and they use the measured points to calibrate a simulation for exploring untested configurations.", "entities": ["model:qwen", "model:qwen-2.5"], "first_seen": "2026-09-15T04:00:00Z", "id": "evt_e45a3548a7d56165", "importance_score": 5.54, "last_updated": "2026-09-17T04:00:00Z", "source_ids": ["arxiv-cs-cl", "arxiv-cs-ai"]}
{"article_ids": ["c60864f37894392f"], "canonical_title": "NVIDIA Vera Rubin NVL72 Delivers Leading Performance in MLPerf Inference v6.1 Debut", "category": "infrastructure", "confidence": 0.85, "description": "The NVIDIA Vera Rubin NVL72 system achieved the leading performance score in the MLPerf Inference v6.1 benchmark debut, demonstrating superior throughput and efficiency compared to competing systems.", "entities": ["org:nvidia", "term:nvidia"], "first_seen": "2026-09-16T15:00:48Z", "id": "evt_c60864f37894392f", "importance_score": 5.522, "last_updated": "2026-09-16T15:00:48Z", "source_ids": ["nvidia"]}
