{"article_ids": ["02bfed5e7aa817ea", "8cfe95d5a7efcad0"], "canonical_title": "Gemini Decisions API: Fast, calibrated multimodal decisions", "category": "developer_tools", "confidence": 0.9, "description": "Google introduced the Gemini Decisions API, powered by the Gemini Decision model. The API offers fast, calibrated multimodal decisions and supports three question types—yes/no, choice, and rubric‑scoring—mirroring the functionality of existing decision models like Jev and OpenAI’s offering. It reuses Jev’s term “Noul” for yes/no queries and is priced at $0.10 per million input tokens, with output tokens free.", "entities": ["model:gemini", "model:gpt", "model:gpt-6", "org:google", "org:openai", "term:gpt"], "first_seen": "2026-11-11T18:00:00Z", "id": "evt_02bfed5e7aa817ea", "importance_score": 5.51, "last_updated": "2026-11-11T22:03:25Z", "source_ids": ["google-ai", "simon-willison"]}
{"article_ids": ["df992b7cd2c69467"], "canonical_title": "UAEF: A framework-agnostic system for closed-loop evaluation of AI agents", "category": "benchmark", "confidence": 0.96, "description": "The Universal Agent Evaluation Framework (UAEF) was introduced as a framework-agnostic system that converts AI-agent execution traces from any framework into a single canonical format, applies 36 built-in metrics across seven dimensions, and stores the results to allow teams to compare agent versions and detect regressions.", "entities": ["term:uaef"], "first_seen": "2026-11-11T15:50:55Z", "id": "evt_df992b7cd2c69467", "importance_score": 5.17, "last_updated": "2026-11-11T15:50:55Z", "source_ids": ["aws-machine-learning"]}
{"article_ids": ["8556616005ab5618"], "canonical_title": "How DXC Technology built a multi-model AI substrate on Amazon Bedrock", "category": "ai_agents", "confidence": 0.8, "description": "DXC Technology created DCX OASIS, a Human+AI operating model that runs on Amazon Bedrock. The system separates a resilient multi‑model substrate from a trusted harness that orchestrates, governs, and audits AI agents at scale for its managed‑IT services.", "entities": ["org:amazon", "term:dcx", "term:dxc", "term:oasis"], "first_seen": "2026-11-11T20:45:45Z", "id": "evt_8556616005ab5618", "importance_score": 5.14, "last_updated": "2026-11-11T20:45:45Z", "source_ids": ["aws-machine-learning"]}
{"article_ids": ["24bc76c8a5ccec32"], "canonical_title": "Detecting and recovering from silent data corruption on Amazon SageMaker HyperPod", "category": "infrastructure", "confidence": 0.95, "description": "AWS introduced three runtime checks in a PyTorch Distributed Data Parallel (DDP) loop on Amazon SageMaker HyperPod that detect silent GPU data corruption, identify the faulty node, and trigger automatic replacement of that node for recovery.", "entities": ["org:amazon", "product:pytorch", "term:ddp"], "first_seen": "2026-11-11T23:30:03Z", "id": "evt_24bc76c8a5ccec32", "importance_score": 4.865, "last_updated": "2026-11-11T23:30:03Z", "source_ids": ["aws-machine-learning"]}
{"article_ids": ["37a8e4c6f0598154"], "canonical_title": "Introducing the Web Search API on Amazon Bedrock AgentCore", "category": "model_release", "confidence": 0.95, "description": "Amazon announced a Web Search API on Bedrock AgentCore that lets code perform web searches with a single signed API call, requiring no gateway or provisioned resources. The API is callable via AWS SDKs or the AWS CLI and can be used in applications, agent loops, and data pipelines.", "entities": ["org:amazon", "term:aws", "term:cli"], "first_seen": "2026-11-11T23:13:16Z", "id": "evt_37a8e4c6f0598154", "importance_score": 4.74, "last_updated": "2026-11-11T23:13:16Z", "source_ids": ["aws-machine-learning"]}
