{"article_ids": ["a458a7a32accc471"], "canonical_title": "VEPA: Verified Evolving Formal Policy for Lifelong LLM Agent Guardrails", "category": "research", "confidence": 0.94, "description": "The paper \"VEPA: Verified Evolving Formal Policy for Lifelong LLM Agent Guardrails\" introduces a framework called VEPA that provides runtime guardrails for large language model agents. VEPA aims to make allow/deny decisions inspectable, reproducible, and deterministic before agents execute potentially irreversible actions, and it is designed to evolve as safety and security requirements change after deployment.", "entities": ["term:vepa"], "first_seen": "2026-10-12T04:00:00Z", "id": "evt_a458a7a32accc471", "importance_score": 6.69, "last_updated": "2026-10-12T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["d2dabc55598a631b"], "canonical_title": "Mitigating Capability Degradation in LLM Self-Improvement via Representation Geometry Regularization", "category": "research", "confidence": 0.78, "description": "The paper identifies that On-Policy Self‑Distillation (OPSD), a self‑improvement method where an LLM serves as both teacher and student, can progressively degrade capabilities that were previously correct. To address this, the authors introduce Representation Geometry Regularization, a technique aimed at preserving earlier abilities while the model continues to self‑train.", "entities": ["term:opsd"], "first_seen": "2026-10-12T04:00:00Z", "id": "evt_d2dabc55598a631b", "importance_score": 6.19, "last_updated": "2026-10-12T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["bdf19a77b367bdc2"], "canonical_title": "MADS: Multi-Agent Dialog Simulation for Robust Conversational Agents", "category": "research", "confidence": 0.9, "description": "The paper introduces MADS (Multi-Agent Dialog Simulation), a synthetic data generation pipeline that produces structured, diverse dialogue trajectories, including non‑cooperative and adversarial user behaviors, to address the scarcity of such examples in existing function‑calling benchmarks.", "entities": ["term:mads"], "first_seen": "2026-10-12T04:00:00Z", "id": "evt_bdf19a77b367bdc2", "importance_score": 5.74, "last_updated": "2026-10-12T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["e95d576c8d03209f"], "canonical_title": "SynAct: Synergistic Active Feedback Learning for LLM Agents", "category": "research", "confidence": 0.6, "description": "The paper presents SynAct, a learning framework that lets large language model (LLM) agents identify when they encounter knowledge gaps—errors that cannot be fixed by retrying—and request targeted expert feedback. It distinguishes these gaps from recoverable slips and focuses feedback on points where it can change the outcome, addressing the scarcity of expert attention.", "entities": [], "first_seen": "2026-10-12T04:00:00Z", "id": "evt_e95d576c8d03209f", "importance_score": 5.69, "last_updated": "2026-10-12T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
{"article_ids": ["23d65be69b099d33"], "canonical_title": "SWE-Duel: Towards a Self-Scaling Arena for Coding Agents", "category": "research", "confidence": 0.9, "description": "The authors propose SWE-Duel, an evaluation arena where two coding agents generate tasks and oracles at evaluation time, eliminating pre-existing benchmark content and allowing difficulty to adapt to the agents' capabilities.", "entities": ["term:swe"], "first_seen": "2026-10-12T04:00:00Z", "id": "evt_23d65be69b099d33", "importance_score": 5.64, "last_updated": "2026-10-12T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
