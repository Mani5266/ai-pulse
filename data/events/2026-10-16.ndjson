{"article_ids": ["8845c0eef99a97d4"], "canonical_title": "Meta and Apple team up to make Muse AI models run better on Macs", "category": "developer_tools", "confidence": 0.7, "description": "Meta announced its Muse Spark open-weight AI model, describing it as the most capable U.S. open-weight model to date. In partnership with Apple, Meta said Muse Spark is the first model of its class that can run on a desktop using two Apple M5 Ultra Mac Studios and the latest MLX framework.", "entities": ["org:apple", "org:meta", "term:mlx"], "first_seen": "2026-10-15T18:15:36Z", "id": "evt_8845c0eef99a97d4", "importance_score": 6.253, "last_updated": "2026-10-15T18:15:36Z", "source_ids": ["the-verge-ai"]}
{"article_ids": ["381c08cf57748156"], "canonical_title": "Amortizing Sequential Experimental Design in Reasoning LLMs", "category": "research", "confidence": 0.73, "description": "A new method is introduced that amortizes sequential Bayesian experimental design (BED) into large language models (LLMs). The approach trains the LLM's reasoning to select actions using information‑gain rewards, while keeping the experimental generative model separate from the LLM itself.", "entities": ["term:bed"], "first_seen": "2026-10-16T04:00:00Z", "id": "evt_381c08cf57748156", "importance_score": 6.04, "last_updated": "2026-10-16T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
{"article_ids": ["44ca59220e0462e6"], "canonical_title": "Targeted ads delivered 0-click exploits to install mercenary malware", "category": "security", "confidence": 0.9, "description": "A targeted advertising campaign delivered zero‑click exploits that silently installed mercenary spyware/malware on victims' devices. The report describes this as the first confirmed instance of mercenary spyware being delivered via ad content.", "entities": [], "first_seen": "2026-10-15T20:32:41Z", "id": "evt_44ca59220e0462e6", "importance_score": 6.018, "last_updated": "2026-10-15T20:32:41Z", "source_ids": ["ars-technica"]}
{"article_ids": ["369f65bd0511e1b4"], "canonical_title": "Open From Data Center to Desktop: NVIDIA Expands Nemotron Family With Highest Efficiency Super VL and Bolt Models", "category": "ai_agents", "confidence": 0.95, "description": "NVIDIA announced three new Nemotron 3.5 models: the Super VL, an open 120‑billion‑parameter model marketed as the fastest and most accurate for always‑on agents, and two edge‑focused Bolt models – the 74‑billion‑parameter Bolt 74B‑A9B with 24 GB memory, and the 4‑GB Bolt E4B designed for local agentic workloads.", "entities": ["model:nemotron", "model:nemotron-3.5", "org:nvidia", "term:gb", "term:nvidia", "term:vl"], "first_seen": "2026-10-15T15:00:24Z", "id": "evt_369f65bd0511e1b4", "importance_score": 5.768, "last_updated": "2026-10-15T15:00:24Z", "source_ids": ["nvidia"]}
{"article_ids": ["0e0776f86cfc7f19"], "canonical_title": "RAC: A Relational Agent Contract for Constraint-Governed Engineering Tasks", "category": "research", "confidence": 0.6, "description": "The paper introduces RAC, a relational agent contract that standardizes the action and feedback interface for engineering agents that must satisfy exact, coupled constraints. RAC is described as harness‑agnostic and authoritative, aiming to replace ad‑hoc mechanisms that cause failures when agents derive precise geometry or timing from semantic decisions.", "entities": ["term:rac"], "first_seen": "2026-10-16T04:00:00Z", "id": "evt_0e0776f86cfc7f19", "importance_score": 5.64, "last_updated": "2026-10-16T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
