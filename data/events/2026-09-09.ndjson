{"article_ids": ["b16e0bc22bc5f9a0"], "canonical_title": "Reasoning-Aware Compression: Identifying and Protecting Vulnerable Reasoning Circuits for Energy-Efficient LLM Deployment", "category": "research", "confidence": 0.78, "description": "Researchers introduced a compression approach that evaluates quantization effects on reasoning performance across five benchmarks (GSM8K, FOLIO, MATH-500, ProofWriter, MuSiQue) and measures GPU energy. The method profiles each model module to identify vulnerable reasoning circuits and applies selective quantization instead of uniform quantization.", "entities": ["term:folio", "term:mat"], "first_seen": "2026-09-09T04:00:00Z", "id": "evt_b16e0bc22bc5f9a0", "importance_score": 6.29, "last_updated": "2026-09-09T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["deaba7abbaf6c640"], "canonical_title": "What LLM Trading Agents Actually Do in Production: A Six-Month, Population-Scale Record from Two Fleets", "category": "research", "confidence": 0.8, "description": "The paper presents a continuous, population‑scale measurement of autonomous language‑model trading agents in live production. It covers two systems with a shared design: DX Terminal Pro, which operated 3,505 user‑funded vaults trading real ETH in Base memecoin markets for 21 days (Feb‑Mar 2026), and the DXAP live‑alpha fleet, which had 500‑599 user‑created agents (91‑117 active concurrently) trading Hyperliquid perpetuals from June to August 2026. The record spans six months and documents real‑world trading activity.", "entities": ["term:dx", "term:dxap", "term:eth"], "first_seen": "2026-09-09T04:00:00Z", "id": "evt_deaba7abbaf6c640", "importance_score": 6.29, "last_updated": "2026-09-09T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
