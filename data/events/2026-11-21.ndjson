{"article_ids": ["f6e744ab21c05ceb"], "canonical_title": "Cut self-hosted LLM cost and latency with the distributed KV caching agent skill", "category": "ai_agents", "confidence": 0.93, "description": "AWS announced a new distributed key‑value (KV) caching skill for its Agent Toolkit. The skill uses Amazon ElastiCache to cache LLM context across GPU instances, cutting inference cost by up to 40% and reducing time‑to‑first‑token by up to 80% for self‑hosted models.", "entities": ["org:amazon", "term:aws", "term:kv"], "first_seen": "2026-11-21T00:14:26Z", "id": "evt_f6e744ab21c05ceb", "importance_score": 6.39, "last_updated": "2026-11-21T00:14:26Z", "source_ids": ["aws-machine-learning"]}
{"article_ids": ["d5bec1fa3b07f617"], "canonical_title": "Introducing Amazon SageMaker HyperPod Global Inference Gateway: One endpoint across Regions and clusters", "category": "model_release", "confidence": 0.95, "description": "SageMaker HyperPod now includes a Global Inference Gateway, a single managed endpoint that routes inference requests across HyperPod clusters within a region or across regions. The gateway automatically selects the best cluster, provides automatic fail‑over, and authenticates each request with SigV4 and IAM over AWS PrivateLink.", "entities": ["org:amazon", "term:aws", "term:iam"], "first_seen": "2026-11-20T22:35:24Z", "id": "evt_d5bec1fa3b07f617", "importance_score": 5.29, "last_updated": "2026-11-20T22:35:24Z", "source_ids": ["aws-machine-learning"]}
{"article_ids": ["6728ab5448c93c9a"], "canonical_title": "Announcing Amazon Textract Insights: Verifiable generative AI for documents", "category": "model_release", "confidence": 0.96, "description": "Amazon announced the general availability of Textract Insights, a new generative AI feature of Amazon Textract. Users can describe the fields they need in natural language, submit a document or mixed packet, and receive structured results that include a confidence score and page‑level grounding for each extracted value, without requiring any model training.", "entities": ["org:amazon"], "first_seen": "2026-11-20T20:22:00Z", "id": "evt_6728ab5448c93c9a", "importance_score": 5.29, "last_updated": "2026-11-20T20:22:00Z", "source_ids": ["aws-machine-learning"]}
