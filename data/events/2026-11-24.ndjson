{"article_ids": ["4a7944a6b20a53a7"], "canonical_title": "AutoPILOT: A Visual Agent Harness for Real-Time Gameplay", "category": "research", "confidence": 0.7, "description": "The paper introduces AutoPILOT, a visual‑agent harness designed to let multimodal foundation models play video games that run continuously. It addresses a gap where existing models perform well only when the game pauses for them. Unlike prior harnesses such as VISTA, which limit each model call to a single action, AutoPILOT manages what the model sees, remembers, and translates outputs into actions more frequently, supporting real‑time interaction.", "entities": ["term:vista"], "first_seen": "2026-11-24T05:00:00Z", "id": "evt_4a7944a6b20a53a7", "importance_score": 6.39, "last_updated": "2026-11-24T05:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["105d2dd6f5d647be"], "canonical_title": "GLM-5.4: Toward Generalized Coding with Our First Loop Transformer", "category": "model_release", "confidence": 0.8, "description": "Chinese AI lab Z.ai announced the availability of GLM-5.4, its first model built with a loop transformer architecture. In this design a group of weight‑shared layers iterates multiple times per forward pass, refining hidden states and creating a deeper network without adding parameters.", "entities": ["term:glm"], "first_seen": "2026-11-23T23:40:49Z", "id": "evt_105d2dd6f5d647be", "importance_score": 5.888, "last_updated": "2026-11-23T23:40:49Z", "source_ids": ["simon-willison"]}
{"article_ids": ["5fa7069343d0cd91"], "canonical_title": "The Effect of Security-Focused Prompts on Reported Findings: A Controlled Experiment on 400 AI-Generated Web Applications", "category": "research", "confidence": 0.6, "description": "Researchers conducted a controlled experiment with 400 AI‑generated web applications. Using 100 frozen specifications, each was realized four times by two agentic coding tools (including Claude Code). A fixed block of OWASP‑aligned security requirements was appended to the prompt for half the runs to test whether the prompts altered the tools' defaults for authentication, session handling, input validation, and dependency management, and to observe any side effects.", "entities": ["term:owasp"], "first_seen": "2026-11-24T05:00:00Z", "id": "evt_5fa7069343d0cd91", "importance_score": 5.84, "last_updated": "2026-11-24T05:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["895b540db6a8889e"], "canonical_title": "Finding faster quantum algorithms with agents and formal verification", "category": "ai_agents", "confidence": 0.7, "description": "DeepMind is applying teams of AI agents together with formal verification techniques to create faster quantum algorithms aimed at nuclear fusion research and chemical simulations.", "entities": [], "first_seen": "2026-11-23T16:59:40Z", "id": "evt_895b540db6a8889e", "importance_score": 5.8, "last_updated": "2026-11-23T16:59:40Z", "source_ids": ["google-deepmind"]}
{"article_ids": ["b24333cc89f9425e"], "canonical_title": "Introducing the Amazon Bedrock Trusted Access API with Anthropic’s Enterprise Frontier Safeguards and Enterprise Data Controls", "category": "model_release", "confidence": 0.96, "description": "Amazon Bedrock announced a Trusted Access API that lets users discover, request, and enroll in model provider programs. In public preview it includes Anthropic’s Enterprise Frontier Safeguards and Enterprise Data Controls, which give users control over data when using Claude Fable models.", "entities": ["model:claude", "org:amazon", "org:anthropic", "term:edc", "term:efs"], "first_seen": "2026-11-24T05:01:14Z", "id": "evt_b24333cc89f9425e", "importance_score": 5.74, "last_updated": "2026-11-24T05:01:14Z", "source_ids": ["aws-machine-learning"]}
