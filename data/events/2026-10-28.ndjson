{"article_ids": ["10a0df171a06e25d"], "canonical_title": "OA-RAG: Ontology-based Agentic RAG for Faithful LLM Reasoning", "category": "research", "confidence": 0.78, "description": "The paper OA-RAG proposes a new Retrieval‑Augmented Generation (RAG) approach that integrates an ontology‑driven agentic component. By explicitly modeling logical relationships between retrieved facts, the system aims to produce answers that are more faithful to established knowledge, addressing the hallucination problem common in large language models.", "entities": ["term:oa"], "first_seen": "2026-10-28T04:00:00Z", "id": "evt_10a0df171a06e25d", "importance_score": 6.14, "last_updated": "2026-10-28T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["4c4715dd3cccfc76"], "canonical_title": "ETC-Bench: A Multilingual Benchmark for Evaluation-Side Transcript Canonicalization", "category": "research", "confidence": 0.85, "description": "The authors define evaluation-side transcript canonicalization (ETC) as mapping multiple surface transcript forms to a single canonical form when differences are not determined by the speech signal. They release ETC-Bench, which they claim is the first and most comprehensive multilingual benchmark for this task, covering 181 phenomena across languages.", "entities": ["term:etc"], "first_seen": "2026-10-28T04:00:00Z", "id": "evt_4c4715dd3cccfc76", "importance_score": 5.39, "last_updated": "2026-10-28T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["773b088116f54808"], "canonical_title": "Google’s next Genie AI model generates more realistic experiences", "category": "product", "confidence": 0.9, "description": "Google announced the Genie 4 world model, an AI system for generating interactive experiences. The model adds four updates: it creates more realistic virtual worlds, allows users to modify an experience in real time using natural‑language prompts, can generate audio content, and runs on the Gemini 3.8 Flash architecture.", "entities": ["model:gemini", "model:gemini-3.8", "org:google"], "first_seen": "2026-10-27T16:00:00Z", "id": "evt_773b088116f54808", "importance_score": 5.353, "last_updated": "2026-10-27T16:00:00Z", "source_ids": ["the-verge-ai"]}
{"article_ids": ["71cf58516c356f01"], "canonical_title": "How Stable Are LLM-Generated Proofs Under Program Refactoring? A Stress Test for Verifiable Code Generation", "category": "research", "confidence": 0.85, "description": "Researchers introduced RefactorProof, a stress‑test framework that creates 458 Lean‑certified program variants from 185 VERINA benchmark tasks while keeping the specification and original proof unchanged, to examine whether LLM‑generated proofs remain valid after behavior‑preserving refactorings.", "entities": ["term:verina"], "first_seen": "2026-10-28T04:00:00Z", "id": "evt_71cf58516c356f01", "importance_score": 5.29, "last_updated": "2026-10-28T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
