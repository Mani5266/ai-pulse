{"article_ids": ["171ccd7c3fad0b3d"], "canonical_title": "HERMES: Contrast-Aware Knowledge Graph Reasoning from Clinical Notes for Patient Outcome Prediction", "category": "research", "confidence": 0.8, "description": "The authors present HERMES, a contrast-aware knowledge-graph reasoning system that builds a graph directly from unstructured clinical text, preserving relational and temporal information, and uses it for patient outcome prediction. It is positioned as an alternative to models that rely on structured EHR data or flatten notes into sequences.", "entities": ["term:hermes"], "first_seen": "2026-09-21T04:00:00Z", "id": "evt_171ccd7c3fad0b3d", "importance_score": 5.99, "last_updated": "2026-09-21T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["2b8c082274107c0e"], "canonical_title": "LEGIT: Credentialing Protocol for Trustworthy AI Agent Marketplaces", "category": "research", "confidence": 0.6, "description": "The paper introduces LEGIT, a credentialing protocol designed for AI agent marketplaces. It links certification, reputation, and marketplace mechanisms to address the difficulty buyers face in verifying and comparing agent performance across tasks, software, and budgets.", "entities": ["term:legit"], "first_seen": "2026-09-21T04:00:00Z", "id": "evt_2b8c082274107c0e", "importance_score": 5.99, "last_updated": "2026-09-21T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["89006430791c3986"], "canonical_title": "BI-Agent and BI-Bench: Towards Automating End-to-End Business Intelligence", "category": "research", "confidence": 0.73, "description": "The paper presents BI-Agent, a system designed to automate the four core steps of traditional business intelligence pipelines—identifying relevant tables, performing data transformations, constructing join relationships, and answering business questions. Alongside the system, the authors release BI-Bench, a benchmark for evaluating such end-to-end BI automation approaches.", "entities": ["term:bi"], "first_seen": "2026-09-21T04:00:00Z", "id": "evt_89006430791c3986", "importance_score": 5.99, "last_updated": "2026-09-21T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
{"article_ids": ["048e05720c2dca35"], "canonical_title": "Rewarding Efficient Reasoning Improves Abstention on Underspecified Tasks in Reasoning Models", "category": "research", "confidence": 0.86, "description": "A new arXiv paper (arXiv:2609.20846v1) demonstrates that adding a reward for efficient reasoning to large reasoning models (LRMs) reduces their tendency to answer unanswerable questions. The authors compare LRM behavior to a human study, showing humans limit effort on unanswerable tasks while LRMs waste computation, and show that the efficiency reward improves abstention performance.", "entities": ["term:lrm"], "first_seen": "2026-09-21T04:00:00Z", "id": "evt_048e05720c2dca35", "importance_score": 5.84, "last_updated": "2026-09-21T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["5e2a92bc8d98003f"], "canonical_title": "PlaceReasoner-Beta: Reasoning-Driven Macro Placement and Benchmarking", "category": "research", "confidence": 0.7, "description": "The authors present PlaceReasoner-Beta, a new system for automated macro placement that uses a reasoning-driven approach and includes benchmarking. It aims to move beyond traditional methods that rely on hand‑crafted proxy objectives like estimated wirelength and one‑shot numerical optimization, which limit the ability to incorporate visual layout context, design expertise, and downstream physical‑design feedback.", "entities": ["term:vlsi"], "first_seen": "2026-09-21T04:00:00Z", "id": "evt_5e2a92bc8d98003f", "importance_score": 5.64, "last_updated": "2026-09-21T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
