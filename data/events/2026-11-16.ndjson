{"article_ids": ["3908fd128c78406d"], "canonical_title": "RAG-FGO: Dynamic Optimization of Query-Rewriting Agents for Generative RAG", "category": "research", "confidence": 0.7, "description": "The paper titled 'RAG-FGO: Dynamic Optimization of Query-Rewriting Agents for Generative RAG' proposes a new method that dynamically optimizes query-rewriting agents used in retrieval‑augmented generation. It targets three real‑world challenges: noisy retrieval feedback, joint optimization of discrete prompt templates with continuous decoding‑control parameters, and limited generalization of existing approaches.", "entities": ["term:fgo"], "first_seen": "2026-11-16T05:00:00Z", "id": "evt_3908fd128c78406d", "importance_score": 6.19, "last_updated": "2026-11-16T05:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["ceb7e3f71094787a"], "canonical_title": "Universal XSS in uBlock Origin from website-driven element picker", "category": "other", "confidence": 0.6, "description": "A universal cross‑site scripting (XSS) flaw was reported in the uBlock Origin browser extension. The bug originates from the element picker feature, which can be driven by a website to inject malicious script into the extension’s context.", "entities": ["term:url", "term:xss"], "first_seen": "2026-11-16T02:04:48Z", "id": "evt_ceb7e3f71094787a", "importance_score": 5.653, "last_updated": "2026-11-16T02:04:48Z", "source_ids": ["hacker-news"]}
{"article_ids": ["5cc536aed4b9c933"], "canonical_title": "Tabular Population Priors as Structured Retrieval for EHR Medication Set Prediction", "category": "research", "confidence": 0.7, "description": "A paper proposes a task‑aligned retrieval approach for medication set prediction from electronic health records. Instead of retrieving similar patient admissions and letting a language model infer medications, the method uses tabular population priors as a structured retrieval mechanism that directly supports the discrete medication class label prediction task.", "entities": ["term:ehr"], "first_seen": "2026-11-16T05:00:00Z", "id": "evt_5cc536aed4b9c933", "importance_score": 5.64, "last_updated": "2026-11-16T05:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["963bbe19ff67ab44"], "canonical_title": "A Push Down the Mountain: Framing Effects and Internal State Interventions on Collusive Behavior in a Long-Horizon LLM Agent", "category": "research", "confidence": 0.73, "description": "Researchers placed the Gemma 3 12B language model in a simulated London silver‑fixing litigation scenario and ran 260 trials where a counterparty asked the model to collude on silver prices. They varied the counterparty's request using four behavioral‑economics frames (gain, loss, blame, etc.) to test whether sustained gain‑loss framing could sway the LLM toward market manipulation.", "entities": ["model:gemma", "model:gemma-3"], "first_seen": "2026-11-16T05:00:00Z", "id": "evt_963bbe19ff67ab44", "importance_score": 5.39, "last_updated": "2026-11-16T05:00:00Z", "source_ids": ["arxiv-cs-ai"]}
{"article_ids": ["5ac702919025cdc2"], "canonical_title": "OCTAVE: A Capability-Resolved Benchmark for End-to-End HTML5 Game Generation", "category": "research", "confidence": 0.93, "description": "Researchers released OCTAVE, a new benchmark that defines 180 tasks and 1,800 evaluation requirements covering eight capability dimensions for complete HTML5 game generation, aiming to expose which capabilities an AI system implements versus those it lacks.", "entities": ["term:octave"], "first_seen": "2026-11-16T05:00:00Z", "id": "evt_5ac702919025cdc2", "importance_score": 5.29, "last_updated": "2026-11-16T05:00:00Z", "source_ids": ["arxiv-cs-ai"]}
