{"article_ids": ["2b6bb81c8606cdfd"], "canonical_title": "The Hidden Costs of 99% Accuracy: A Trustworthiness Audit of the Telco Customer Churn Benchmark", "category": "research", "confidence": 0.8, "description": "Researchers audited the IBM Telco Customer Churn benchmark (7,043 records) and identified four trustworthiness failures. They showed that applying SMOTE before the train‑test split artificially raises the churn‑class F1 score by 13.1 percentage points across ten classifiers and fifteen random seeds (Wilcoxon p≈0.95).", "entities": ["org:ibm", "term:ibm", "term:smote"], "first_seen": "2026-10-02T04:00:00Z", "id": "evt_2b6bb81c8606cdfd", "importance_score": 5.49, "last_updated": "2026-10-02T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
{"article_ids": ["90199fd2e76ca822"], "canonical_title": "Knowing When to Yield: Grounded Arbitration of User Corrections in Text-Based Embodied Agents", "category": "research", "confidence": 0.73, "description": "The paper introduces GAVA (Grounded Arbitration of User Corrections), a decision interface for text‑based embodied agents that chooses among accepting, rejecting, inspecting the environment, or asking the user when a correction may be wrong. GAVA uses observation‑bounded evidence, legal probes, and a one‑step expected‑loss rule. Experiments in the ALFWorld text‑only benchmark use 162 checkpoints with 972 true/false intervention pairs to evaluate the approach.", "entities": ["term:gava"], "first_seen": "2026-10-02T04:00:00Z", "id": "evt_90199fd2e76ca822", "importance_score": 5.49, "last_updated": "2026-10-02T04:00:00Z", "source_ids": ["arxiv-cs-ai"]}
