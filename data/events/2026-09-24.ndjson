{"article_ids": ["42ef0943d405e536"], "canonical_title": "COPE: Continual Personalization of LLMs under Sparse User Feedback via User Embeddings and Self-Evaluation", "category": "research", "confidence": 0.85, "description": "Researchers introduced COPE, a framework that uses user embeddings and self‑evaluation to continually personalize large language models even when user feedback is sparse, addressing limitations of prompt‑based training‑free methods and static post‑training fine‑tuning.", "entities": ["term:cope"], "first_seen": "2026-09-24T04:00:00Z", "id": "evt_42ef0943d405e536", "importance_score": 6.49, "last_updated": "2026-09-24T04:00:00Z", "source_ids": ["arxiv-cs-lg"]}
{"article_ids": ["449a2bb4ef316043"], "canonical_title": "COMED: The Missing Middle Between Routing and Collaboration in Multi-LLM Inference", "category": "research", "confidence": 0.8, "description": "The paper presents COMED, a new approach that sits between pure routing (selecting a single LLM) and dense collaboration (invoking all peers) for multi‑LLM inference. It observes that dense collaboration is non‑monotonic: additional peers can fix failures that no single model solves, but can also corrupt answers that were initially correct. COMED is designed to capture the benefits of collaboration while mitigating its downsides.", "entities": ["term:comed"], "first_seen": "2026-09-24T04:00:00Z", "id": "evt_449a2bb4ef316043", "importance_score": 6.49, "last_updated": "2026-09-24T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["159c9f3751cfda61"], "canonical_title": "LEGO: Synergizing Expert GraphRAG and Expert Chain-of-Thought for Legal Reasoning", "category": "research", "confidence": 0.78, "description": "Researchers introduced LEGO, a new system that merges Expert GraphRAG retrieval with Expert Chain‑of‑Thought prompting to tackle two known limits of legal AI: (1) existing RAG/GraphRAG methods focus on lexical or semantic similarity and miss normative relationships between legal provisions, and (2) standard Chain‑of‑Thought can produce plausible but structurally unsound arguments. LEGO explicitly models normative links and guides reasoning steps to produce more legally coherent outputs.", "entities": ["term:lego"], "first_seen": "2026-09-24T04:00:00Z", "id": "evt_159c9f3751cfda61", "importance_score": 6.19, "last_updated": "2026-09-24T04:00:00Z", "source_ids": ["arxiv-cs-cl"]}
{"article_ids": ["39b901174b543376", "5b206843ef211175", "4e56c7312349a760"], "canonical_title": "Grok 4.7", "category": "other", "confidence": 0.7, "description": "Ringg deployed AI agents built on OpenAI’s GPT‑5.6 that can handle voice, chat, WhatsApp and web interactions. The agents reportedly resolve up to 65 % of customer calls and claim a 90 % cost reduction compared with using GPT‑4.1.", "entities": ["model:claude", "model:gpt", "model:gpt-4.1", "model:gpt-5.6", "model:gpt-6", "model:grok", "model:grok-4", "model:grok-4.7", "org:anthropic", "org:openai", "term:gpt", "term:url"], "first_seen": "2026-09-21T15:50:15Z", "id": "evt_39b901174b543376", "importance_score": 5.9, "last_updated": "2026-09-23T12:00:00Z", "source_ids": ["hacker-news", "simon-willison", "openai"]}
