# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- LLM ---
# Which provider implementation to use: "ollama" (local dev) or "hosted" (CI / production).
AI_PULSE_LLM_PROVIDER=ollama
AI_PULSE_LLM_MODEL=qwen3:4b
# Free tiers to try, in order. A tier without a key is skipped, so one key is just one
# provider. Every free allowance runs out — Groq's is 200,000 tokens a day, about five
# runs — so a chain is what lets a briefing finish rather than publish without prose.
AI_PULSE_LLM_CHAIN=groq,openrouter
AI_PULSE_GROQ_API_KEY=
AI_PULSE_CEREBRAS_API_KEY=
AI_PULSE_OPENROUTER_API_KEY=
# Per-tier model overrides. Catalogues differ and change; verify before relying on one.
AI_PULSE_GROQ_MODEL=
AI_PULSE_CEREBRAS_MODEL=
AI_PULSE_OPENROUTER_MODEL=

# Single-key configuration, still honoured when no tier key is set.
AI_PULSE_LLM_API_KEY=
AI_PULSE_LLM_BASE_URL=
# Base URL of a local Ollama server. Only used when AI_PULSE_LLM_PROVIDER=ollama.
AI_PULSE_OLLAMA_HOST=http://localhost:11434
# Let a reasoning model think before answering. Off: measured 227s per call with
# thinking on against 8s with it off, for no gain on a schema-filling task.
AI_PULSE_OLLAMA_THINK=false
# Hard ceiling on model calls per pipeline run. 25 nominal (one per shortlisted event
# plus one per briefing story); the rest is headroom for the single retry each is allowed.
AI_PULSE_LLM_CALL_BUDGET=60
# Per-call timeout in seconds.
AI_PULSE_LLM_TIMEOUT=120

# --- Delivery ---
# Let anyone message the bot and read the briefing, for a demo. Read-only:
# /refresh and /status stay with the owner, so this cannot spend the model budget.
AI_PULSE_PUBLIC_READ_ONLY=false
AI_PULSE_PUBLIC_REPLY_SECONDS=20

AI_PULSE_TELEGRAM_BOT_TOKEN=
AI_PULSE_TELEGRAM_CHAT_ID=

# Notice when a run succeeds but produces less than it should. GitHub already emails on a
# failed workflow; this is for the run that exits zero and publishes two stories instead of
# five. Only fires when the shortlist actually held enough — a quiet day stays quiet.
AI_PULSE_ALERT_ON_DEGRADED=true
AI_PULSE_ALERT_MIN_STORIES=3

# --- Ingestion ---
AI_PULSE_HTTP_CONNECT_TIMEOUT=5.0
AI_PULSE_HTTP_READ_TIMEOUT=15.0
AI_PULSE_HTTP_MAX_RESPONSE_BYTES=5242880
AI_PULSE_HTTP_MAX_REDIRECTS=3

# --- Recency ---
# How far back a first run looks, with no previous briefing to anchor to.
AI_PULSE_FIRST_RUN_DAYS=2
# Cap on the catch-up window after a missed run or two.
AI_PULSE_MAX_CATCHUP_DAYS=7
# How far back the briefing reports, independent of what a given run ingested.
AI_PULSE_BRIEFING_LOOKBACK_HOURS=36

# --- Pipeline ---
# Events surviving deterministic filtering, i.e. the maximum the LLM ever sees.
AI_PULSE_MAX_EVENTS_TO_LLM=20
# Cap on how much of that shortlist any single category may take.
AI_PULSE_MAX_EVENTS_PER_CATEGORY=4
# Stories in the final briefing.
AI_PULSE_STORIES_PER_BRIEFING=5
# How many days of history deduplication remembers.
AI_PULSE_DEDUP_MEMORY_DAYS=7
# Title similarity above which two articles are treated as the same article.
AI_PULSE_DEDUP_TITLE_THRESHOLD=0.90

# Blended entity-and-title score above which an article joins an existing event.
AI_PULSE_CLUSTER_THRESHOLD=0.45
# How long a running event stays open to new articles.
AI_PULSE_EVENT_MEMORY_DAYS=14

# --- Runtime ---
AI_PULSE_DATA_DIR=data
AI_PULSE_SITE_DIR=site
AI_PULSE_LOG_LEVEL=INFO
# Optional log file. Scheduled runs have nowhere to print without it.
AI_PULSE_LOG_FILE=data/ai-pulse.log
