# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- LLM ---
# Which provider implementation to use: "ollama" (local dev) or "hosted" (CI / production).
AI_PULSE_LLM_PROVIDER=ollama
AI_PULSE_LLM_MODEL=llama3.1:8b
# Only needed when AI_PULSE_LLM_PROVIDER=hosted.
AI_PULSE_LLM_API_KEY=
AI_PULSE_LLM_BASE_URL=
# Base URL of a local Ollama server. Only used when AI_PULSE_LLM_PROVIDER=ollama.
AI_PULSE_OLLAMA_HOST=http://localhost:11434
# Hard ceiling on model calls per pipeline run. Keeps the run inside every free tier.
AI_PULSE_LLM_CALL_BUDGET=25

# --- Delivery ---
AI_PULSE_TELEGRAM_BOT_TOKEN=
AI_PULSE_TELEGRAM_CHAT_ID=

# --- Ingestion ---
AI_PULSE_HTTP_CONNECT_TIMEOUT=5.0
AI_PULSE_HTTP_READ_TIMEOUT=15.0
AI_PULSE_HTTP_MAX_RESPONSE_BYTES=5242880
AI_PULSE_HTTP_MAX_REDIRECTS=3

# --- Pipeline ---
# Events surviving deterministic filtering, i.e. the maximum the LLM ever sees.
AI_PULSE_MAX_EVENTS_TO_LLM=20
# Stories in the final briefing.
AI_PULSE_STORIES_PER_BRIEFING=5
# How many days of history deduplication remembers.
AI_PULSE_DEDUP_MEMORY_DAYS=7
# Title similarity above which two articles are treated as the same article.
AI_PULSE_DEDUP_TITLE_THRESHOLD=0.90

# --- Runtime ---
AI_PULSE_DATA_DIR=data
AI_PULSE_LOG_LEVEL=INFO
